# ── Required ──────────────────────────────────────────────────────────────────
# ElevenLabs API key. Get one at https://elevenlabs.io
ELEVENLABS_API_KEY=your_key_here

# ── Optional — all have defaults ──────────────────────────────────────────────
# ElevenLabs voice ID (default: Rachel)
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ElevenLabs model ID
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# Server bind address and port (localhost-only, do not change HOST)
HOST=127.0.0.1
PORT=8765

# Audio cache time-to-live in days
AUDIO_CACHE_TTL_DAYS=30

# How often to poll RSS feeds (minutes, minimum 30)
FEED_REFRESH_MINUTES=30

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
